{{- $keepassxc_has_entry := printf "%s/.chezmoitemplates/keepassxc-has-entry" .chezmoi.sourceDir -}}
{{- $hasPersonalGPG := eq (output $keepassxc_has_entry "Personal/GPG" "PGP_PRIVATE_KEY" "PGP_PUBLIC_KEY" | trim) "true" -}}
{{- $hasPersonalEMail := eq (output $keepassxc_has_entry "Personal/EMail" "UserName" | trim) "true" -}}
{{ if and $hasPersonalGPG $hasPersonalEMail -}}
export GPG_TTY=$(tty)
# Delete the key from the keyring to force a re-import after rotating it.
[ -z "${KEEPASSXC_DATABASE}" ] || ! command -v keepassxc-cli &>/dev/null || ! command -v gpg &>/dev/null || {
  gpg --list-secret-keys "{{ keepassxcAttribute "Personal/EMail" "UserName" }}" &>/dev/null ||
  keepassxc-cli show "${KEEPASSXC_ARGS[@]}" "${KEEPASSXC_DATABASE}" "Personal/GPG" --attributes 'PGP_PRIVATE_KEY' --attributes 'PGP_PUBLIC_KEY' | gpg --import
}
{{ end -}}
