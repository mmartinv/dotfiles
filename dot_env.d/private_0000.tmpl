# Note: Unless you are using an individual project (starting with itpc-ca-XXXX),
# leave cloudability-it-gemini in the following commands; that is static and the same for everyone.
# If you have a dedicated project, omit the cloudability-it-gemini parameter.
#     gcloud auth application-default login
#     gcloud auth application-default set-quota-project cloudability-it-gemini

export KEEPASSXC_DATABASE="${HOME}/.passwords.kdbx"
export KEEPASSXC_KEY="${HOME}/.keepassxc.key"
export KEEPASSXC_ENTRY="Accounts/Red Hat"

export KEEPASSXC_ARGS=("--no-password" "--key-file" "${KEEPASSXC_KEY}")

[ ! -f "/etc/os-release" ] ||
[ ! -e "${KEEPASSXC_DATABASE}" ] ||
[ ! -e "${KEEPASSXC_KEY}" ] ||
[ -z "${EMAIL}" ] ||
!command -v gio &>/dev/null ||
gio mount -l | grep -q "google-drive://${EMAIL}" ||
gio mount "google-drive://${EMAIL}"
