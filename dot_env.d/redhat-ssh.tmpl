{{- $keepassxc_has_entry := printf "%s/.chezmoitemplates/keepassxc-has-entry" .chezmoi.sourceDir -}}
{{- $hasRedHatSSH := eq (output $keepassxc_has_entry "Red Hat/SSH" "SSH_ID_RSA" "SSH_ID_RSA_PUB" | trim) "true" -}}
{{ if $hasRedHatSSH -}}
command -v keepassxc-cli >/dev/null 2>&1 && {
  [ -d "${HOME}/.ssh" ] || mkdir -p "${HOME}/.ssh"
  ssh-add -l 2>/dev/null | grep -qF "${HOME}/.ssh/id_rsa_redhat " || {
    [ -f "${HOME}/.ssh/id_rsa_redhat" ] || {
      (umask 077; keepassxc-cli show "${KEEPASSXC_ARGS[@]}" "${KEEPASSXC_DATABASE}" "Red Hat/SSH" --attributes 'SSH_ID_RSA' >"${HOME}/.ssh/id_rsa_redhat")
      keepassxc-cli show "${KEEPASSXC_ARGS[@]}" "${KEEPASSXC_DATABASE}" "Red Hat/SSH" --attributes 'SSH_ID_RSA_PUB' >"${HOME}/.ssh/id_rsa_redhat.pub"
      chmod 600 "${HOME}/.ssh/id_rsa_redhat"
    }
    command -v ssh-add >/dev/null 2>&1 && ssh-add "${HOME}/.ssh/id_rsa_redhat" 2>/dev/null
  }
  [ ! -f "${HOME}/.ssh/id_rsa_redhat.pub" ] ||
  grep -q -s -F -f "${HOME}/.ssh/id_rsa_redhat.pub" "${HOME}/.ssh/authorized_keys" ||
  cat "${HOME}/.ssh/id_rsa_redhat.pub" >>"${HOME}/.ssh/authorized_keys"
}
{{ end -}}
