export GPG_TTY=$(tty)
KEEPASSXC_ARGS=("--no-password" "--key-file" "${HOME}/.keepassxc.key")
KEEPASSXC_DATABASE="${HOME}/.passwords.kdbx"
KEEPASSXC_ENTRY="Accounts/Red Hat"

! command -v keepassxc-cli &>/dev/null || ! command -v gpg &>/dev/null || {
  EMAIL="$(keepassxc-cli show "${KEEPASSXC_ARGS[@]}" "${KEEPASSXC_DATABASE}" "${KEEPASSXC_ENTRY}" --attributes "EMAIL")"
  [ -z "${EMAIL}" ] || gpg --list-secret-keys "${EMAIL}" &>/dev/null ||
  keepassxc-cli show "${KEEPASSXC_ARGS[@]}" "${KEEPASSXC_DATABASE}" "${KEEPASSXC_ENTRY}" --attributes 'PGP_PRIVATE_KEY' --attributes 'PGP_PUBLIC_KEY' | gpg --import
}
