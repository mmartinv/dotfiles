{
  "$schema": "https://opencode.ai/config.json",
  "model": "enmaas/rits/zai-org/glm-5-3",
  "update": "disable",
  "providers": {
    "enmaas": {
      "name": "EnMaaS",
      "env": [
        "ENMAAS_KEY"
      ],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "{env:ENMAAS_BASE_URL}/v1"
      },
      "models": {
        "rits/zai-org/glm-5-3": {
          "name": "GLM 5.3",
          "limit": {
            "context": 1000000,
            "output": 65536
          }
        }
      }
    },
    "openai": {
      "env": [
        "ENMAAS_KEY"
      ],
      "settings": {
        "baseURL": "{env:ENMAAS_BASE_URL}/v1"
      }
    },
    "anthropic": {
      "env": [
        "ENMAAS_KEY"
      ],
      "settings": {
        "baseURL": "{env:ENMAAS_BASE_URL}/v1"
      }
    }
  },
  "mcp": {
    "servers": {
      "attlasian": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v2/mcp",
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
        }
      },
      "gitlab": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@jmrp.io/gitlab-mcp-server"
        ],
        "environment": {
          "GITLAB_URL": "https://gitlab.com",
          "GITLAB_TOKEN": "{env:GITLAB_TOKEN}"
        }
      },
      "gitlab-cee": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@jmrp.io/gitlab-mcp-server"
        ],
        "environment": {
          "GITLAB_URL": "{env:GITLAB_CEE_URL}",
          "GITLAB_TOKEN": "{env:GITLAB_CEE_TOKEN}"
        }
      }
    }
  }
}
